{
  "name": "@ezpaarse-project/ezreeport-vue",
  "version": "3.2.2",
  "homepage": "https://github.com/ezpaarse-project/ezreeport#readme",
  "bugs": {
    "url": "https://github.com/ezpaarse-project/ezreeport/issues"
  },
  "license": "CeCILL",
  "author": "oxypomme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ezpaarse-project/ezreeport.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components.js",
    "./locale": "./dist/locale.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build:docs": "storybook build",
    "prebuild:js": "pnpm up --no-save ~sdk @ezpaarse-project/ezreeport-sdk-js",
    "build:js": "tsdown",
    "dev": "storybook dev -p 6006",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "^0.6.1",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^14.3.0",
    "chroma-js": "^3.2.0",
    "date-fns": "catalog:sdk",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "nanoid": "catalog:sdk",
    "ofetch": "catalog:",
    "pretty-bytes": "^7.1.1",
    "socket.io-client": "catalog:sdk"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@date-io/date-fns": "^3.2.1",
    "@ezpaarse-project/ezreeport-sdk-js": "workspace:*",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-links": "10.5.4",
    "@storybook/vue3-vite": "10.5.4",
    "@tsdown/css": "^0.22.14",
    "@types/chroma-js": "^3.1.2",
    "storybook": "10.5.4",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vue-component-meta": "^3.3.8",
    "vue-tsc": "^3.3.8",
    "~sdk": "workspace:@ezpaarse-project/ezreeport-sdk-js@*"
  },
  "peerDependencies": {
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vuetify": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --fix"
    ],
    "package.json": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
