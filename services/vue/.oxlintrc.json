{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["oxc", "unicorn", "typescript", "import", "node", "promise"],
  "rules": {
    // Allows to import components and assets
    "import/extensions": [
      "error",
      { "pattern": { "*.vue": "never", "*.svg": "never" } }
    ],
    // Allow for i18n
    "id-length": ["warn", { "exceptions": ["t"] }],
    // Enforce browser rules
    "no-nodejs-modules": "error",
    "no-alert": "error",
    "no-script-url": "error",
    "import/no-namespace": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/prefer-event-target": "error",
    "unicorn/prefer-add-event-listener": "error"
  },
  "overrides": [
    {
      "files": ["src/components/**/*.stories.ts"],
      "rules": {
        "explicit-function-return-type": "off",
        // Storybook expect default exports
        "no-default-export": "off",
        // Vue conventions
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["src/components/**/*.example.ts"],
      "rules": {
        // Vue conventions
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["src/components/**/*.vue"],
      "rules": {
        // Vue Components are always modules
        "import/unambiguous": "off",
        // Vue conventions
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["src/composables/*.ts"],
      "rules": {
        // Auto imports expect default exports
        "import/no-default-export": "off",
        // Vue conventions
        "unicorn/filename-case": "off"
      }
    }
  ]
}
