{
  "name": "@ezpaarse-project/ezreeport-admin",
  "version": "2.0.0",
  "description": "CLI for managing ezreeport instance",
  "homepage": "https://github.com/ezpaarse-project/ezreeport",
  "bugs": "https://github.com/ezpaarse-project/ezreeport/issues",
  "license": "CeCILL",
  "author": "oxypomme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ezpaarse-project/ezreeport.git"
  },
  "bin": {
    "ezra": "./bin/run.js",
    "ezreeport-admin": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "type": "module",
  "main": "",
  "types": "dist/index.d.ts",
  "exports": "./lib/index.js",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "prepack": "oclif manifest && oclif readme",
    "postpack": "shx rm -f oclif.manifest.json",
    "publish": "npm publish",
    "type-check": "tsc --noEmit --skipLibCheck",
    "version": "oclif readme && git add README.md"
  },
  "dependencies": {
    "@inquirer/prompts": "^6.0.1",
    "@oclif/core": "^4.11.14",
    "@oclif/plugin-autocomplete": "^3.2.53",
    "@oclif/plugin-help": "^6.2.53",
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "object-treeify": "^4.0.1",
    "ora": "^8.2.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/chai": "^5.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/lodash": "^4.17.9",
    "@types/node": "catalog:",
    "@types/semver": "^7.5.8",
    "oclif": "^4.14.35",
    "shx": "^0.4.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
