{% extends "layout.mjml" %} {% block title %}
<mj-title>{{ $t('mail.types.failed.body.title', data) }}</mj-title>
{% endblock %} {% block content %}

<mj-section>
  <mj-column>
    <mj-text>
      <p>
        {{ $t('mail.report.failed.body.content.report', data) | safe }}
      </p>
      <p>{{ $t('mail.report.failed.body.content.error', data) | safe }}</p>
      <ul>
        <li>
          {{
            $t('mail.report.failed.body.content.details.report', data) | safe
          }}
        </li>
        <li>
          {{
            $t('mail.report.failed.body.content.details.namespace', data) | safe
          }}
        </li>
        <li>
          {{ $t('mail.report.failed.body.content.details.date', data) | safe }}
        </li>
        <li>
          {{
            $t('mail.report.failed.body.content.details.recurrence', data) |
              safe
          }}
        </li>
        <li>
          {{
            $t('mail.report.failed.body.content.details.period', data) | safe
          }}
        </li>
        <li>
          {{
            $t('mail.report.failed.body.content.details.message', data) | safe
          }}
        </li>
      </ul>
      <p>{{ $t('mail.report.failed.body.content.attachment', data) | safe }}</p>
      <p>
        {{ $t('mail.report.failed.body.content.automated', data) | safe }}
      </p>
    </mj-text>
  </mj-column>
</mj-section>

{% endblock %}
