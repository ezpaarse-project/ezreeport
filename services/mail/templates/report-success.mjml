{% extends "layout.mjml" %} {% block title %}
<mj-title>{{ $t('mail.types.success.body.title', data) }}</mj-title>
{% endblock %} {% block content %}

<mj-section>
  <mj-column>
    <mj-text>
      <p>
        {{ $t('mail.report.success.body.content.report', data) | safe }}
      </p>
      <p>
        {{ $t('mail.report.success.body.content.generation', data) | safe }}
      </p>
      <p>
        {{ $t('mail.report.success.body.content.automated', automated) | safe }}
      </p>
    </mj-text>

    <mj-text
      align="center"
      color="#55575d"
      font-size="24px"
      line-height="22px"
      padding="10px 25px"
    >
      {{ $t('mail.report.success.body.content.attachment', data) | safe }}
    </mj-text>

    <mj-text>
      <p>
        {{ $t('mail.report.success.body.content.unsubscribe', data) | safe }}
      </p>
    </mj-text>
  </mj-column>
</mj-section>

{% endblock %}
