{
  "name": "@ezreeport/database",
  "version": "1.3.0",
  "private": false,
  "description": "",
  "homepage": "https://github.com/ezpaarse-project/ezreeport#readme",
  "bugs": {
    "url": "https://github.com/ezpaarse-project/ezreeport/issues"
  },
  "license": "CeCILL",
  "author": "oxypomme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ezpaarse-project/ezreeport.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "db:deploy": "prisma migrate deploy",
    "db:diff": "dotenvx run -- prisma migrate diff --from-schema-datasource prisma --to-schema-datamodel prisma",
    "db:generate": "dotenvx run -- prisma generate",
    "db:gui": "dotenvx run -- prisma studio",
    "db:migrate": "dotenvx run -- prisma migrate dev --skip-generate",
    "db:push": "dotenvx run -- prisma db push --skip-generate",
    "db:reset": "dotenvx run -- prisma migrate reset --skip-generate",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "check": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ezreeport/heartbeats": "workspace:*",
    "@ezreeport/logger": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.18.0",
    "prisma": "^7.9.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^20 || ^22 || ^24"
  }
}
